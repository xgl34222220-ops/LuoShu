<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ owns the initial splash: one opaque background color, the 书 emblem
         on a cream icon circle, and the platform's default exit into the real App. -->
    <style name="Theme.LuoShuLaunch" parent="Theme.LuoShuHybrid">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_luoshu_splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_icon_background</item>
    </style>
</resources>
