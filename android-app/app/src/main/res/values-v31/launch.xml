<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ owns the initial splash and only accepts one opaque background
         color: the diffuse backdrop centre. Its icon is a glass orb with the same
         diffuse colours and the original icon tile; the platform's default exit reveals
         the native preparation frame, the first frame of the full-screen launch shell. -->
    <style name="Theme.LuoShuLaunch" parent="Theme.LuoShuHybrid">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_luoshu_launch</item>
    </style>
</resources>
