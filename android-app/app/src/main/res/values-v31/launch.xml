<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ owns the initial splash: one opaque deep navy color (same in light and
         dark), the original icon art filling the icon box, light system-bar content, and
         the platform's default exit into the real App. -->
    <style name="Theme.LuoShuLaunch" parent="Theme.LuoShuHybrid">
        <item name="android:windowBackground">@color/launch_splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_luoshu_splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
