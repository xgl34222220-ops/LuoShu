<?xml version="1.0" encoding="utf-8"?>
<!-- API 28–30 starting window: deep navy vertical gradient with the original icon art
     centered at 240dp, matching the Android 12+ splash. The Activity swaps in its real
     backdrop (Theme.LuoShuHybrid) before its first content frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270"
                android:startColor="@color/launch_splash_gradient_top"
                android:endColor="@color/launch_splash_gradient_bottom" />
        </shape>
    </item>
    <item android:width="240dp" android:height="240dp" android:gravity="center"
        android:drawable="@drawable/ic_luoshu_splash" />
</layer-list>
