        android:name="diffuse_lens"
        android:fillAlpha="0.24"
        android:pathData="M54,19a35,35 0,1 0,0 70a35,35 0,1 0,0 -70">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="28" android:startY="24"
                android:endX="82" android:endY="88">
                <item android:offset="0" android:color="@color/launch_glass_top" />
                <item android:offset="0.48" android:color="@color/launch_glass_center" />
                <item android:offset="1" android:color="@color/launch_glass_bottom" />
            </gradient>
        </aapt:attr>
    </path>
    <path
