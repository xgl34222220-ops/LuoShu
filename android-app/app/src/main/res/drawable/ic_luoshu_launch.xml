<?xml version="1.0" encoding="utf-8"?>
<!--
  One static native glass emblem; never another full-screen branding layer.
  The glass lens fits Android's 192dp safe circle in the 288dp icon canvas.
  Gradients are native vector fills: no blur, bitmap decode, animator or delay.
-->
