<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher icon paper and guide tone (same in both themes; the icon is a cream tile). -->
    <color name="luoshu_icon_paper">#F6EFDD</color>
    <color name="luoshu_icon_guide">#C9A98A</color>
    <!-- The platform splash accepts one opaque color. Light uses the icon's cream paper. -->
    <color name="launch_background">#F6EFDD</color>
    <!-- Cream circle behind the splash glyph, so dark mode still shows the paper tile. -->
    <color name="launch_icon_background">#F6EFDD</color>
    <color name="launch_gradient_start">#CDDDF4</color>
    <color name="launch_gradient_center">#E2DDF3</color>
    <color name="launch_gradient_end">#D1E8ED</color>
    <color name="launch_ink">#435B80</color>
    <bool name="launch_light_system_bars">true</bool>

    <style name="Theme.LuoShuHybrid" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@drawable/luoshu_launch_background</item>
        <item name="android:colorBackground">@color/launch_background</item>
        <item name="android:windowLightStatusBar">@bool/launch_light_system_bars</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">@bool/launch_light_system_bars</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <!-- API 28–30 starting window mirrors the Android 12+ splash: launch color plus the
         centered 书 emblem. The Activity swaps in its real backdrop before content. -->
    <style name="Theme.LuoShuLaunch" parent="Theme.LuoShuHybrid">
        <item name="android:windowBackground">@drawable/luoshu_launch_splash</item>
    </style>
</resources>
