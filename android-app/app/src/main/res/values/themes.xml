<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="launch_background">#F7F6F2</color>
    <color name="launch_ink">#536B8E</color>
    <color name="launch_gold">#B39864</color>
    <bool name="launch_light_system_bars">true</bool>

    <style name="Theme.LuoShuHybrid" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:colorBackground">@color/launch_background</item>
        <item name="android:windowLightStatusBar">@bool/launch_light_system_bars</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">@bool/launch_light_system_bars</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <!-- API 28–30 use the starting window itself; no extra Activity or loading page. -->
    <style name="Theme.LuoShuLaunch" parent="Theme.LuoShuHybrid">
        <item name="android:windowBackground">@drawable/luoshu_launch_background</item>
    </style>
</resources>
