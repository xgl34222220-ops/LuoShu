<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Miuix Blur only executes behind the API 33 RuntimeShader capability gate.
      Keep the app installable on API 28-32, where LuoShu uses the safe Haze fallback.
    -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--
      未覆盖界面定位 lists installed apps (user and system) so the user picks one instead of typing a
      package name. Read-only: labels and icons only; root `pm list packages` remains the fallback.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".LuoShuApplication"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_luoshu"
        android:roundIcon="@mipmap/ic_luoshu"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LuoShuHybrid"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LuoShuLaunch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TaskCenterActivity"
            android:exported="false" />

        <service
            android:name=".NativeImportForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <receiver
            android:name=".NativeImportActionReceiver"
            android:exported="false" />

        <!-- 导出完整诊断 → 分享: cache/reports only, read grant per share intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.reports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/coverage_report_paths" />
        </provider>
    </application>

</manifest>
