#!/sbin/sh
# Standard root-manager module installer entry.
umask 022
OUTFD=$2
ZIPFILE=$3
export OUTFD ZIPFILE
ui_print() { echo "$1"; }
require_new_magisk() {
  ui_print "*******************************"
  ui_print " 请使用 Magisk v20.4+、KernelSU 或 APatch 安装"
  ui_print "*******************************"
  exit 1
}
mount /data 2>/dev/null
[ -f /data/adb/magisk/util_functions.sh ] || require_new_magisk
. /data/adb/magisk/util_functions.sh
[ "$MAGISK_VER_CODE" -lt 20400 ] && require_new_magisk
install_module
exit 0
